<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER"
      prefHeight="349.0"
      prefWidth="602.0"
      spacing="20.0"
      xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="com.sanchez.jorge.controller.UsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <TextField fx:id="txtUsuario" prefHeight="25.0" prefWidth="187.0" promptText="Ingrese nombre de usuario" />
   <PasswordField fx:id="passwordContrasena" promptText="Ingrese contraseña" />
   <PasswordField fx:id="passwordRepetirContrasena" layoutX="30.0" layoutY="75.0" promptText="Repita la contraseña" />
   <TextField fx:id="txtRut" promptText="Ingrese rut" />
    <Button fx:id="buttonCrearUsuario" onAction="#onUsuarioButtonClick" text="Crear Usuario" />
   <TableView fx:id="tableUsuarios" prefHeight="99.0" prefWidth="562.0">
     <columns>
       <TableColumn prefWidth="75.0" text="C1" />
       <TableColumn prefWidth="75.0" text="C2" />
     </columns>
   </TableView>

    <Label fx:id="welcomeText" />
</VBox>
